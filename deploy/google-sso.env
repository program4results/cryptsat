# Single sign-on with the saltracker.com Google Workspace tenant (customer C03k8s1sz).
# Copy into the platform environment settings. None of these values is secret: the client id only identifies
# the app (Cloud project cryptsat-mdm-login, audience Internal). The client secret is not used and not stored.
#
# MFA: 2-Step Verification is enforced on the top organisational unit (confirmed 2026-10-08 with
#   gam select saltracker print users fields primaryemail,isenrolledin2sv,isenforcedin2sv
# showing isEnforcedIn2Sv True for every account). Google's tokens are not relied on to report MFA,
# so the service trusts that enforcement. If enforcement is ever switched off, change CRYPTSAT_OIDC_MFA
# back to amr (which then refuses every sign-in) until it is restored.

CRYPTSAT_AUTH=oidc
CRYPTSAT_OIDC_ISSUER=https://accounts.google.com
CRYPTSAT_OIDC_AUDIENCE=492450667127-ir7p1r6mmr99p5uhbpf4v3qpbf7kgi59.apps.googleusercontent.com
CRYPTSAT_OIDC_MFA=idp-enforced
# The tenant also holds emis.education and k2gum.com; they are deliberately not allowed to sign in.
CRYPTSAT_OIDC_ALLOWED_DOMAINS=saltracker.com,program4results.com
# Google advises checking the hd (hosted domain) claim, not only the email, so a personal Google account
# using one of these addresses cannot get in. Both values are listed because whether Google reports a
# secondary-domain user's hd as their own domain or the primary domain is not verified.
CRYPTSAT_OIDC_HOSTED_DOMAINS=saltracker.com,program4results.com
